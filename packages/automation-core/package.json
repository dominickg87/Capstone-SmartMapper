{
  "name": "@smartmapper/automation-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    "./active-tab": {
      "types": "./dist/active-tab.d.ts",
      "default": "./dist/active-tab.js"
    },
    "./browser-page": {
      "types": "./dist/browser-page.d.ts",
      "default": "./dist/browser-page.js"
    },
    "./mapping-memory": {
      "types": "./dist/mapping-memory.d.ts",
      "default": "./dist/mapping-memory.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@smartmapper/contracts": "workspace:*"
  }
}
