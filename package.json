{
  "name": "smartmapper-capstone",
  "version": "0.1.0",
  "private": true,
  "description": "SmartMapper capstone built on the MIA Chrome extension, with shared automation packages and a synthetic test lab.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:extension": "pnpm --filter @smartmapper/mia-chrome-extension build",
    "build:mia-extension": "pnpm --filter @smartmapper/mia-chrome-extension build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:mock-carriers": "pnpm --filter @smartmapper/mock-carriers dev",
    "dev:extension": "pnpm --filter @smartmapper/mia-chrome-extension dev",
    "dev:api": "pnpm --filter @smartmapper/orchestrator-api dev",
    "dev:worker": "pnpm --filter @smartmapper/automation-worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.13.3",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
