# Azure App Service settings. No Azure API key is needed.
NODE_ENV=production
SMARTMAPPER_CHECKPOINT_STORE=azure
# Local supervised testing only; production rejects true.
SMARTMAPPER_ALLOW_ANY_CARRIER=false
# Opt in to ordinary Next/Continue only after a clean whole-page review (ADR 0012).
SMARTMAPPER_AUTO_NEXT=false
AZURE_OPENAI_BASE_URL=https://foundry-smartmap-prod.services.ai.azure.com/openai/v1/
AZURE_OPENAI_MODEL_DEPLOYMENT=smartmapper-astra-dev
AZURE_STORAGE_TABLE_ENDPOINT=https://stsmartmapperdevdg.table.core.windows.net/
AZURE_STORAGE_JOBS_TABLE=SmartMapperJobs
SMARTMAPPER_DEFAULT_REASONING_EFFORT=high
SMARTMAPPER_ESCALATION_REASONING_EFFORT=max

# Required explicit deployment scope; comma-separated exact values, no wildcards.
# Examples are placeholders. Obtain the real values using docs/SMARTMAPPER_V2_SETUP.md.
SMARTMAPPER_EXTENSION_IDS=
SMARTMAPPER_MIA_ORIGINS=
SMARTMAPPER_ALLOWED_PRINCIPALS=
SMARTMAPPER_CARRIER_ORIGINS=

# Already configured privately in Azure; never commit the actual value here.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# App Service provides PORT. For local runs use 4300.
SMARTMAPPER_API_PORT=4300
