# Supporting core/API/worker examples; the MIA extension does not read this file.
# Set its demo portal URL in the extension Settings and sign in through MIA.

# Local application URLs
SMARTMAPPER_MOCK_CARRIER_URL=http://127.0.0.1:4173
SMARTMAPPER_API_URL=http://127.0.0.1:4300

# Mock M.I.A. provider (synthetic fixtures only)
MIA_PROVIDER=memory
MIA_FIXTURE_SET=synthetic-default

# Future approved M.I.A. development API; do not place a credential here
MIA_DEVELOPMENT_API_BASE_URL=https://development-api.example.invalid
MIA_AUTH_SECRET_NAME=TBD_SECURE_SECRET_NAME

# AI provider boundary; mock is the only bootstrap implementation
AI_PROVIDER=mock
AI_PROVIDER_SECRET_NAME=TBD_SECURE_SECRET_NAME

# Future Azure resource references; no keys or connection strings
AZURE_QUEUE_RESOURCE_REFERENCE=TBD_APPROVED_RESOURCE_REFERENCE
AZURE_JOB_STORE_RESOURCE_REFERENCE=TBD_APPROVED_RESOURCE_REFERENCE
AZURE_ARTIFACT_STORAGE_REFERENCE=TBD_APPROVED_RESOURCE_REFERENCE

# Future approved notification callback
NOTIFICATION_CALLBACK_URL=https://callback.example.invalid

# PII-safe logging and short-lived local artifacts
LOG_LEVEL=info
ARTIFACT_RETENTION_HOURS=0
