# Exact origins, without a trailing slash. No tokens or API keys belong here.
VITE_SMARTMAPPER_BACKEND_ORIGIN=https://asp-smartmapper-dev-fgbqddfbewfrd2at.eastus-01.azurewebsites.net
# Replace with the demo agency's tenant origin before building for that account.
VITE_SMARTMAPPER_MIA_ORIGIN=https://mia.test
# The extension still relies on activeTab, so this does not add blanket carrier host permissions.
VITE_SMARTMAPPER_ALLOW_ANY_CARRIER=true
# Used when any-carrier mode is false and for the local synthetic lab.
VITE_SMARTMAPPER_CARRIER_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
