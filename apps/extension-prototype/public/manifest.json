{
  "manifest_version": 3,
  "name": "M.I.A. SmartMapper Mock Prototype",
  "version": "0.1.0",
  "description": "Localhost-only SmartMapper capstone prototype using synthetic data.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:4173/*", "http://127.0.0.1:4173/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartMapper mock run"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:4173/*", "http://127.0.0.1:4173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
