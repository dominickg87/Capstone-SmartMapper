{
  "manifest_version": 3,
  "name": "M.I.A. SmartMapper POC",
  "version": "0.3.15",
  "minimum_chrome_version": "116",
  "description": "Map a M.I.A. Homeowners quote with a deterministic demo profile.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://demo.mia.agency/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://demo.mia.agency/extension/connect*"
      ],
      "js": [
        "auth-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open SmartMapper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}